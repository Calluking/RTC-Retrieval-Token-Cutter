digraph StorageSubgraph {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.55, ranksep=0.7];
  node [shape=ellipse, style="filled", fillcolor="white", color="black", penwidth=2, fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=11, color="black", penwidth=2, arrowsize=0.8];

  REPO [label="REPO\ndjango/django", style="dashed,filled"];
  PKG [label="PKG\ndjango.core.files", style="dashed,filled"];
  TPKG [label="PKG\ntests.file_storage", style="dashed,filled"];

  FILE [label="FILE\nstorage.py"];
  TFILE [label="FILE\ntests.py"];

  STORAGE [label="CLASS\nStorage"];
  FSS [label="CLASS\nFileSystemStorage"];
  DEFAULT [label="CLASS\nDefaultStorage"];
  GET [label="FUNC\nget_storage_class"];

  PERM [label="CLASS\nFileStoragePermissions"];
  GST [label="CLASS\nGetStorageClassTests"];

  SAVE [label="FUNC\n_save"];
  FILE_PERMS [label="FUNC\nfile_permissions_mode"];
  PATH [label="FUNC\npath"];

  REPO -> PKG [label="contains"];
  REPO -> TPKG [label="contains"];
  PKG -> FILE [label="contains"];
  TPKG -> TFILE [label="contains"];

  FILE -> STORAGE [label="contains"];
  FILE -> FSS [label="contains"];
  FILE -> DEFAULT [label="contains"];
  FILE -> GET [label="contains"];

  FSS -> STORAGE [label="extends", style=dashed];
  DEFAULT -> GET [label="calls", style=dashed];

  FSS -> SAVE [label="contains"];
  FSS -> FILE_PERMS [label="contains"];
  FSS -> PATH [label="contains"];

  TFILE -> PERM [label="contains"];
  TFILE -> GST [label="contains"];

  GST -> GET [label="calls", style=dashed];
  PERM -> FSS [label="calls", style=dashed];
  PERM -> SAVE [label="calls", style=dashed];
  PERM -> PATH [label="calls", style=dashed];
  PERM -> FILE_PERMS [label="checks", style=dashed];
}
