#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"

if [ -f "$ROOT/setup_env.sh" ]; then
  # shellcheck disable=SC1091
  source "$ROOT/setup_env.sh"
fi

export RTC_CLAUDE_PLUGIN_DIR="${RTC_CLAUDE_PLUGIN_DIR:-$HERE}"
exec claude --plugin-dir "$RTC_CLAUDE_PLUGIN_DIR" "$@"
